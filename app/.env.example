# Copier en .env (jamais versionné : voir .gitignore) et remplir. Lu côté serveur uniquement :
# serveur de dev Vite, `npm start` (serveur autonome), `npm run bench`, fonction serverless.
# En ligne (Vercel) : définir les mêmes variables dans les réglages du projet, jamais dans le code.

# Endpoint compatible OpenAI Chat Completions : AMD Token Factory.
AI_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Modèle ouvert retenu après essais (voir README, section Benchmark).
AI_MODEL=DeepSeek-V4-Flash
# Clé personnelle du Token Factory (commence par rc-). Ne jamais la committer, la journaliser
# ni la coller dans un ticket ou une capture.
AI_API_KEY=
# Libellé affiché à côté d'une réponse EN DIRECT (jamais affiché pour le repli pré-enregistré).
AI_LABEL=AMD Token Factory
# DeepSeek-V4-Flash renvoie une erreur 500 avec response_format=json_object : le schéma passe
# dans la consigne et la forme est vérifiée côté serveur. (json_schema strict : MiMo-V2.6-Flash seulement.)
AI_RESPONSE_FORMAT=none
# Génération complète (~30 à 65 s sur l’endpoint d’essai, en streaming) : délai total, attente et nouvelles tentatives comprises (fonction Vercel : 120 s max).
AI_TIMEOUT_MS=110000

# Optionnel
# AI_REASONING_EFFORT=low       # si une réponse revient vide avec finish_reason=length
# AI_RATE_PER_MIN=30            # limite AMD Token Factory : 30 requêtes/min par clé
# AI_MAX_CONCURRENT=2           # file d'attente côté serveur (AMD autorise 8 simultanées)

# Serveur autonome (npm start)
# PORT=8080
# HOST=127.0.0.1                # 0.0.0.0 pour l'exposer (derrière HTTPS)
# ALLOWED_ORIGINS=              # origines autorisées en CORS si l'appli est servie ailleurs
# RATE_LIMIT_PER_MIN=20

# Test local sans IA : `npm run mock` puis
# AI_BASE_URL=http://127.0.0.1:8001/v1
# AI_MODEL=mock-model
# AI_LABEL=FAUX SERVEUR LOCAL (mock, aucune IA)

# Les anciens noms VLLM_BASE_URL, VLLM_MODEL, VLLM_API_KEY, VLLM_LABEL restent lus en repli.
